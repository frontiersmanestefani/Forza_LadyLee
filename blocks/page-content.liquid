
<div
  class="page-content page-content--full-width"
  style="
    {% if block.settings.text_color != blank %}
      --color: {{ block.settings.text_color }};
      --color-rgb: {{ block.settings.text_color.rgb }};
    {% endif %}
  "
>
  <rte-formatter>
    {{ page.content }}
  </rte-formatter>
</div>

{% stylesheet %}
  .page-content--full-width {
    color: var(--color, inherit);
    width: 100vw;
    max-width: none !important;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-left: 0;
    padding-right: 0;
    box-sizing: border-box;
  }

  .page-content--full-width a {
    color: currentcolor;
  }

  .page-content--full-width rte-formatter {
    display: block;
    width: 100%;
    max-width: none !important;
  }

  .page-content--full-width img,
  .page-content--full-width video,
  .page-content--full-width iframe {
    max-width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.page_content",
  "class": "rte",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    }
  ]
}
{% endschema %}
