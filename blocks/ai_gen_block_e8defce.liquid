{% doc %}
  @prompt
    crea otro componente para collage de fotos lifestyle
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-lifestyle-collage-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__heading {
    margin: 0 0 20px;
    color: {{ block.settings.text_color }};
    font-family: var(--font-heading--family, sans-serif);
    font-size: clamp(24px, 3vw, {{ block.settings.heading_size }}px);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    grid-template-rows: repeat(2, minmax(150px, {{ block.settings.tile_height }}px));
    gap: {{ block.settings.gap }}px;
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__tile {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: #f1f1f1;
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__tile:first-child {
    grid-row: span 2;
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__image,
  .ai-lifestyle-collage-{{ ai_gen_id }}__placeholder,
  .ai-lifestyle-collage-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__image,
  .ai-lifestyle-collage-{{ ai_gen_id }}__placeholder svg {
    object-fit: cover;
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__placeholder svg {
    background: #f1f1f1;
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__empty {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    padding: 8px 10px;
    color: #333333;
    background: rgba(255, 255, 255, 0.92);
    font-size: 13px;
    line-height: 1.4;
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__caption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 34px 16px 14px;
    color: #ffffff;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.72));
    font-size: 14px;
    line-height: 1.35;
  }

  @media screen and (max-width: 749px) {
    .ai-lifestyle-collage-{{ ai_gen_id }}__heading {
      margin-bottom: 14px;
    }

    .ai-lifestyle-collage-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: minmax(180px, 1.25fr) minmax(130px, 0.9fr);
      gap: {{ block.settings.gap | at_most: 16 }}px;
    }

    .ai-lifestyle-collage-{{ ai_gen_id }}__tile:first-child {
      grid-column: span 2;
      grid-row: auto;
    }
  }
{% endstyle %}

<div class="ai-lifestyle-collage-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-lifestyle-collage-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  <div class="ai-lifestyle-collage-{{ ai_gen_id }}__grid">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign caption_key = 'caption_' | append: i
        assign collage_image = block.settings[image_key]
        assign collage_caption = block.settings[caption_key]
      %}
      <div class="ai-lifestyle-collage-{{ ai_gen_id }}__tile">
        {% if collage_image != blank %}
          <img
            class="ai-lifestyle-collage-{{ ai_gen_id }}__image"
            src="{{ collage_image | image_url: width: 1400 }}"
            alt="{{ collage_image.alt | default: collage_caption | escape }}"
            loading="lazy"
            width="{{ collage_image.width }}"
            height="{{ collage_image.height }}"
          >
          {% if collage_caption != blank %}
            <div class="ai-lifestyle-collage-{{ ai_gen_id }}__caption">{{ collage_caption | escape }}</div>
          {% endif %}
        {% else %}
          <div class="ai-lifestyle-collage-{{ ai_gen_id }}__placeholder">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-lifestyle-collage-{{ ai_gen_id }}__empty">Añade una foto lifestyle {{ i }} en la configuración del bloque.</div>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collage lifestyle",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Historias sobre ruedas"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del título",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Foto principal"
    },
    {
      "type": "text",
      "id": "caption_1",
      "label": "Texto de foto principal"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Foto 2"
    },
    {
      "type": "text",
      "id": "caption_2",
      "label": "Texto de foto 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Foto 3"
    },
    {
      "type": "text",
      "id": "caption_3",
      "label": "Texto de foto 3"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Ancho en escritorio",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "tile_height",
      "label": "Altura de las fotos",
      "min": 160,
      "max": 400,
      "step": 20,
      "unit": "px",
      "default": 240
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espacio entre fotos",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Redondeo de esquinas",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Collage lifestyle"
    }
  ],
  "tag": null,
  "class": "lifestyle-collage-block"
}
{% endschema %}