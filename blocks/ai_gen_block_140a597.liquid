{% doc %}
  @prompt
    crea un grid tipo collage de fotos para subir varias fotos lifestyle del producto 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-lifestyle-collage-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    color: {{ block.settings.text_color }};
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__heading {
    margin: 0 0 18px;
    color: inherit;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.1;
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(100px, 1fr);
    gap: {{ block.settings.gap }}px;
    aspect-ratio: 1.8 / 1;
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__item {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: #f1f1f1;
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__item--1 {
    grid-column: span 2;
    grid-row: span 2;
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__item img,
  .ai-lifestyle-collage-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
    min-height: 110px;
  }

  .ai-lifestyle-collage-{{ ai_gen_id }}__empty-label {
    position: absolute;
    inset-inline: 8px;
    bottom: 10px;
    color: #333333;
    font-size: 12px;
    line-height: 1.4;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-lifestyle-collage-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-lifestyle-collage-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
      aspect-ratio: auto;
    }

    .ai-lifestyle-collage-{{ ai_gen_id }}__item {
      aspect-ratio: 1 / 1;
    }

    .ai-lifestyle-collage-{{ ai_gen_id }}__item--1 {
      grid-column: span 2;
      grid-row: span 1;
      aspect-ratio: 1.5 / 1;
    }
  }
{% endstyle %}

<div class="ai-lifestyle-collage-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-lifestyle-collage-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  <div class="ai-lifestyle-collage-{{ ai_gen_id }}__grid">
    {% for i in (1..5) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign image = block.settings[image_key]
      %}
      <div class="ai-lifestyle-collage-{{ ai_gen_id }}__item ai-lifestyle-collage-{{ ai_gen_id }}__item--{{ i }}">
        {% if image != blank %}
          <img src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">
        {% else %}
          <div class="ai-lifestyle-collage-{{ ai_gen_id }}__placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
          {% if forloop.first %}
            <span class="ai-lifestyle-collage-{{ ai_gen_id }}__empty-label">Agrega fotos lifestyle para mostrar tu producto en uso</span>
          {% endif %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collage lifestyle",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "El producto en acción"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Foto principal"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Foto 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Foto 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Foto 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Foto 5"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Ancho en escritorio",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espacio entre fotos",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Redondeo de esquinas",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Collage lifestyle"
    }
  ],
  "tag": null,
  "class": "lifestyle-collage-block"
}
{% endschema %}