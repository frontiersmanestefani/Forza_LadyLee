{% comment %}
  ============================================================
  BUSCADOR CON CATEGORIAS

  Campo de busqueda + desplegable de categorias. Envia a /search.

  Por que etiquetas y no colecciones: Shopify no sabe buscar "dentro
  de una coleccion" desde un formulario, y en esta tienda todos los
  productos comparten el mismo product_type (LL080109 y compania), asi
  que tampoco sirve. Lo que si funciona es la sintaxis de busqueda de
  Shopify acotando por etiqueta:

      q=aro 20 AND tag:"Coleccion Bicicleta General"

  Y resulta que cada coleccion tiene su etiqueta propia, puesta en
  todos sus productos. Eso es lo que usa el desplegable.

  La lista se edita desde el editor, una linea por categoria:
      Nombre que se ve|Etiqueta exacta
  Una linea sin etiqueta busca en todo.
  ============================================================
{% endcomment %}

{% liquid
  assign uid = block.id | replace: '_', '' | downcase

  assign rows = block.settings.categories | strip | newline_to_br
  assign rows = rows | replace: '<br />', '~' | replace: '<br/>', '~' | replace: '<br>', '~'
  assign lines = rows | split: '~'
%}

<div class="buscador-cat buscador-cat-{{ uid }}" {{ block.shopify_attributes }}>

  {% if block.settings.heading != blank %}
    <h2 class="buscador-cat-{{ uid }}__heading">{{ block.settings.heading }}</h2>
  {% endif %}

  <form
    class="buscador-cat__form buscador-cat-{{ uid }}__form"
    action="{{ routes.search_url }}"
    method="get"
    role="search"
  >
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">

    <label class="buscador-cat__sr" for="buscador-cat-{{ uid }}-q">
      {{ block.settings.input_label }}
    </label>
    <input
      class="buscador-cat-{{ uid }}__input"
      id="buscador-cat-{{ uid }}-q"
      type="search"
      name="q"
      placeholder="{{ block.settings.placeholder | escape }}"
      autocomplete="off"
    >

    <label class="buscador-cat__sr" for="buscador-cat-{{ uid }}-cat">
      {{ block.settings.select_label }}
    </label>
    <select
      class="buscador-cat__category buscador-cat-{{ uid }}__select"
      id="buscador-cat-{{ uid }}-cat"
    >
      {%- for line in lines -%}
        {%- assign parts = line | strip | split: '|' -%}
        {%- assign nombre = parts[0] | strip -%}
        {%- assign etiqueta = parts[1] | strip -%}
        {%- if nombre != blank -%}
          <option value="{{ etiqueta | escape }}">{{ nombre }}</option>
        {%- endif -%}
      {%- endfor -%}
    </select>

    <button class="buscador-cat-{{ uid }}__button" type="submit">
      {{ block.settings.button_label }}
    </button>
  </form>

</div>

{% style %}
  .buscador-cat-{{ uid }} {
    width: {{ block.settings.width }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding }}px 0;
  }

  .buscador-cat-{{ uid }}__heading {
    margin: 0 0 14px;
    color: {{ block.settings.text_color }};
    font-family: var(--font-heading--family, sans-serif);
    font-size: clamp(18px, 2.2vw, 24px);
    text-transform: uppercase;
    text-align: center;
  }

  .buscador-cat-{{ uid }}__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    background: {{ block.settings.field_background }};
    border: 2px solid {{ block.settings.border_color }};
  }

  .buscador-cat-{{ uid }}__input,
  .buscador-cat-{{ uid }}__select {
    min-width: 0;
    border: 0;
    background: transparent;
    color: {{ block.settings.text_color }};
    font-family: inherit;
    font-size: 15px;
    padding: 14px 16px;
  }

  .buscador-cat-{{ uid }}__input {
    flex: 1 1 240px;
  }

  .buscador-cat-{{ uid }}__input::placeholder {
    color: {{ block.settings.text_color }};
    opacity: .55;
  }

  .buscador-cat-{{ uid }}__select {
    flex: 0 1 auto;
    border-left: 2px solid {{ block.settings.border_color }};
    cursor: pointer;
    /* el nativo de iOS ignora el fondo transparente, por eso el propio */
    appearance: none;
    -webkit-appearance: none;
    padding-right: 38px;
    background-image: linear-gradient(45deg, transparent 50%, {{ block.settings.text_color }} 50%),
                      linear-gradient(135deg, {{ block.settings.text_color }} 50%, transparent 50%);
    background-position: calc(100% - 20px) calc(50% + 2px), calc(100% - 14px) calc(50% + 2px);
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
  }

  .buscador-cat-{{ uid }}__input:focus-visible,
  .buscador-cat-{{ uid }}__select:focus-visible {
    outline: 3px solid {{ block.settings.accent_color }};
    outline-offset: -3px;
  }

  .buscador-cat-{{ uid }}__button {
    flex: 0 0 auto;
    border: 0;
    background: {{ block.settings.accent_color }};
    color: #ffffff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 14px 28px;
    cursor: pointer;
    transition: background .2s ease;
  }

  .buscador-cat-{{ uid }}__button:hover {
    background: {{ block.settings.text_color }};
  }

  .buscador-cat-{{ uid }}__button:focus-visible {
    outline: 3px solid {{ block.settings.text_color }};
    outline-offset: 2px;
  }

  .buscador-cat__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* en celular cada control ocupa su propia fila */
  @media screen and (max-width: 640px) {
    .buscador-cat-{{ uid }}__form {
      flex-direction: column;
    }

    .buscador-cat-{{ uid }}__select {
      border-left: 0;
      border-top: 2px solid {{ block.settings.border_color }};
      background-position: calc(100% - 20px) calc(50% + 2px), calc(100% - 14px) calc(50% + 2px);
    }

    .buscador-cat-{{ uid }}__button {
      width: 100%;
    }
  }
{% endstyle %}

<script>
  (function () {
    var forms = document.querySelectorAll('.buscador-cat__form');
    if (!forms.length) return;

    forms.forEach(function (form) {
      if (form.dataset.buscadorListo) return;
      form.dataset.buscadorListo = '1';

      form.addEventListener('submit', function (event) {
        var select = form.querySelector('.buscador-cat__category');
        var campo = form.querySelector('input[name="q"]');
        if (!select || !campo) return;

        var etiqueta = select.value;
        if (!etiqueta) return; // "todas": el formulario viaja tal cual

        event.preventDefault();

        var termino = (campo.value || '').trim();
        var consulta = 'tag:"' + etiqueta + '"';
        if (termino) consulta = termino + ' AND ' + consulta;

        var params = new URLSearchParams();
        params.set('q', consulta);
        params.set('type', 'product');
        params.set('options[prefix]', 'last');

        window.location.href = form.getAttribute('action') + '?' + params.toString();
      });
    });
  })();
</script>
{% style %}
  /* Forza es tienda de consulta: sin carrito ni cuentas */
  .header-actions__cart-icon,
  .account-button {
    display: none !important;
  }
{% endstyle %}
{% schema %}
{
  "name": "Buscador con categorías",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "info": "Dejalo vacío para no mostrarlo.",
      "default": "¿Qué estás buscando?"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Texto de ayuda del campo",
      "default": "Buscá por modelo, aro, color…"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Buscar"
    },
    {
      "type": "textarea",
      "id": "categories",
      "label": "Categorías",
      "info": "Una línea por categoría, con el formato Nombre|Etiqueta. La etiqueta tiene que ser exactamente la que llevan los productos de esa colección. Una línea sin etiqueta busca en todo.",
      "default": "Todas las categorías|\nMotos|Coleccion Motocicletas 2 Ruedas\nBicicletas|Coleccion Bicicleta General\nAccesorios|Coleccion Accesorios Motociclista General"
    },
    {
      "type": "header",
      "content": "Accesibilidad"
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Nombre del campo de búsqueda",
      "info": "No se ve; lo leen los lectores de pantalla.",
      "default": "Buscar productos"
    },
    {
      "type": "text",
      "id": "select_label",
      "label": "Nombre del desplegable",
      "default": "Categoría"
    },
    {
      "type": "header",
      "content": "Apariencia"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color del botón",
      "default": "#E60000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "field_background",
      "label": "Fondo del campo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color del borde",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Ancho",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Espacio arriba y abajo",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Buscador con categorías"
    }
  ],
  "tag": null
}
{% endschema %}