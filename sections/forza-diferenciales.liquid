            class="forza-card__media"
            style="background-image: url({{ section.settings.image_2 | image_url: width: 900 }}); background-position: {{ section.settings.position_2 }};"
          ></div>
        {%- endif -%}

        <div class="forza-card__veil"></div>

        <div class="forza-number">02</div>

        <div class="forza-card__content">

          <h3>{{ section.settings.title_2 }}</h3>

          <p>{{ section.settings.text_2 }}</p>

        </div>

      </div>


      <!-- ==================================================
           03 · EFICIENCIA
      =================================================== -->

