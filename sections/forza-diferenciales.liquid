            class="forza-card__media"
            style="background-image: url({{ section.settings.image_3 | image_url: width: 900 }}); background-position: {{ section.settings.position_3 }};"
          ></div>
        {%- endif -%}

        <div class="forza-card__veil"></div>

        <div class="forza-number">03</div>

        <div class="forza-card__content">

