{% comment %}
  ============================================================
  FORZA - DIFERENCIALES
  Sección para Homepage de Shopify
  Línea gráfica: Negro / Blanco / Rojo
  ============================================================
{% endcomment %}

{%- liquid
  assign veil = section.settings.overlay_opacity | times: 0.01
  assign veil_mid = veil | times: 0.94
  assign veil_top = veil | times: 0.6

  assign veil_hover = section.settings.overlay_opacity_hover | times: 0.01
  assign veil_hover_mid = veil_hover | times: 0.7
  assign veil_hover_top = veil_hover | times: 0.25
-%}

<section class="forza-diferenciales">

  <div class="forza-container">

    <!-- ======================================================
         ENCABEZADO
    ======================================================= -->

