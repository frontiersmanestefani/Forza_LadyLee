<!-- ==========================================================
     ESTILOS
=========================================================== -->

<style>

  /* ==========================================================
     CONTENEDOR PRINCIPAL
  =========================================================== */

  .forza-diferenciales {
    background: #000000;
    color: #ffffff;
    padding: 70px 20px;
    position: relative;
    overflow: hidden;
  }


  /* Línea roja decorativa */

  .forza-diferenciales::before {

    content: "";

    position: absolute;

    top: 0;

    right: 8%;

    width: 2px;

    height: 180px;

    background: #E60000;

    transform: skewX(-18deg);

    opacity: .9;

  }


  .forza-container {

    max-width: 1200px;

    margin: 0 auto;

  }


  /* ==========================================================
     HEADER
  =========================================================== */

  .forza-header {

    text-align: center;

    max-width: 720px;

    margin: 0 auto 45px;

  }


  .forza-kicker {

    color: #E60000;

    font-size: 13px;

    font-weight: 800;

    letter-spacing: 2px;

    margin-bottom: 10px;

  }


  .forza-header h2 {

    color: #ffffff;

    font-size: clamp(30px, 4vw, 48px);

    line-height: 1.05;

    margin: 0 0 15px;

    font-weight: 900;

    text-transform: uppercase;

    letter-spacing: -1px;

  }


  .forza-header p {

    color: #bbbbbb;

    font-size: 17px;

    margin: 0;

  }


  /* ==========================================================
     GRID
  =========================================================== */

  .forza-grid {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 2px;

    background: #292929;

  }


  /* ==========================================================
     CARDS
  =========================================================== */

  .forza-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    background: #080808;
    padding: 32px 28px;
    min-height: 245px;
    transition: transform .25s ease;
  }

  .forza-card:hover {
    transform: translateY(-3px);
  }

  /* la foto */
  .forza-card__media {
    position: absolute;
    inset: 0;
    background-size: cover;
    transform: scale(1.03);
    transition: transform .6s ease;
  }

  .forza-card:hover .forza-card__media {
    transform: scale(1.05);
  }

  /* el vidrio: desenfoque + degradado a negro */
  .forza-card__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, {{ veil }}) 0%,
      rgba(0, 0, 0, {{ veil_mid }}) 38%,
      rgba(0, 0, 0, {{ veil_top }}) 100%
    );
    -webkit-backdrop-filter: blur({{ section.settings.overlay_blur }}px) saturate(115%);
    backdrop-filter: blur({{ section.settings.overlay_blur }}px) saturate(115%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .14),
      inset 0 0 0 1px rgba(255, 255, 255, .05);
    transition:
      background .45s ease,
      -webkit-backdrop-filter .45s ease,
      backdrop-filter .45s ease;
  }

  /* al pasar el cursor el vidrio se levanta: foto nitida y velo minimo */
  .forza-card:hover .forza-card__veil {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, {{ veil_hover }}) 0%,
      rgba(0, 0, 0, {{ veil_hover_mid }}) 45%,
      rgba(0, 0, 0, {{ veil_hover_top }}) 100%
    );
    -webkit-backdrop-filter: blur(0) saturate(105%);
    backdrop-filter: blur(0) saturate(105%);
  }

  /* con el velo levantado el texto se apoya en su propia sombra */
  .forza-card h3,
  .forza-card p,
  .forza-number {
    text-shadow: 0 1px 10px rgba(0, 0, 0, .85);
  }

  .forza-card__content {
    position: relative;
  }


  /* ==========================================================
     NUMERACIÓN
  =========================================================== */

  .forza-number {

    position: absolute;

    top: 22px;

    right: 25px;

    font-size: 12px;

    color: rgba(255, 255, 255, .6);

    font-weight: 800;

    letter-spacing: 1px;

  }


  /* ==========================================================
     TITULOS
  =========================================================== */

  .forza-card h3 {

    color: #ffffff;

    margin: 0 0 9px;

    font-size: 20px;

    line-height: 1.2;

    font-weight: 800;

    text-transform: uppercase;

  }


  /* ==========================================================
     TEXTO
  =========================================================== */

  .forza-card p {

    color: #d2d2d2;

    font-size: 14px;

    line-height: 1.6;

    margin: 0 auto;

    max-width: 32ch;

  }


  .forza-card strong {

    color: #ffffff;

  }


  /* ==========================================================
     TABLET
  =========================================================== */

  @media screen and (max-width: 900px) {

    .forza-grid {

      grid-template-columns: repeat(2, 1fr);

    }

  }


  /* ==========================================================
     MOBILE
  =========================================================== */

  @media screen and (max-width: 600px) {

    .forza-diferenciales {

      padding: 50px 15px;

    }


    .forza-header {

      margin-bottom: 30px;

    }


    .forza-header h2 {

      font-size: 30px;

    }


    .forza-header p {

      font-size: 15px;

    }


    .forza-grid {

      grid-template-columns: 1fr;

      gap: 1px;

    }


    .forza-card {

      min-height: auto;

      padding: 25px 22px;

    }


  }

</style>


