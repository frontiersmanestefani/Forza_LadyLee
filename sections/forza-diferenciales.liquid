        {{ section.settings.heading }}
      </h2>

      {% if section.settings.subheading != blank %}
        <p>
          {{ section.settings.subheading }}
        </p>
      {% endif %}

    </div>


    <!-- ======================================================
         CARACTERÍSTICAS
    ======================================================= -->

    <div class="forza-grid">


      <!-- ==================================================
           01 · MOTOR
      =================================================== -->

      <div class="forza-card">

        {%- if section.settings.image_1 != blank -%}
          <div
            class="forza-card__media"
            style="background-image: url({{ section.settings.image_1 | image_url: width: 900 }}); background-position: {{ section.settings.position_1 }};"
          ></div>
        {%- endif -%}

        <div class="forza-card__veil"></div>

        <div class="forza-number">01</div>

        <div class="forza-card__content">

          <h3>{{ section.settings.title_1 }}</h3>

          <p>{{ section.settings.text_1 }}</p>

