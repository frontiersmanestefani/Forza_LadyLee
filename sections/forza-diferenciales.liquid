{% comment %}
  ============================================================
  FORZA - DIFERENCIALES
  Sección para Homepage de Shopify
  Línea gráfica: Negro / Blanco / Rojo
  ============================================================
{% endcomment %}

<section class="forza-diferenciales">

  <div class="forza-container">

    <!-- ======================================================
         ENCABEZADO
    ======================================================= -->

    <div class="forza-header">

      <div class="forza-kicker">
        FORZA · FUERZA SIN LÍMITES
      </div>

      <h2>
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.subheading != blank %}
        <p>
          {{ section.settings.subheading }}
        </p>
      {% endif %}

    </div>


    <!-- ======================================================
         CARACTERÍSTICAS
    ======================================================= -->

    <div class="forza-grid">


      <!-- ==================================================
           01 · MOTOR
      =================================================== -->

      <div class="forza-card">

        <div class="forza-icon">

          <svg viewBox="0 0 64 64" aria-hidden="true">

            <path
              d="M12 25h26l7 8v13H12z"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

            <path
              d="M38 25v-7h8l5 7"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

            <circle
              cx="24"
              cy="46"
              r="5"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

            <circle
              cx="43"
              cy="46"
              r="5"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

          </svg>

        </div>

        <div class="forza-number">
          01
        </div>

        <h3>
          Motor 149 cc
        </h3>

        <p>
          Motores de <strong>4 tiempos</strong> diseñados para
          ofrecer un equilibrio entre desempeño y eficiencia.
        </p>

      </div>


      <!-- ==================================================
           02 · TRANSMISIÓN
      =================================================== -->

      <div class="forza-card">

        <div class="forza-icon">

          <svg viewBox="0 0 64 64" aria-hidden="true">

            <circle
              cx="20"
              cy="20"
              r="7"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

            <circle
              cx="44"
              cy="20"
              r="7"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

            <circle
              cx="32"
              cy="44"
              r="7"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

            <path
              d="M20 27v9l12 8M44 27v9L32 44"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

          </svg>

        </div>

        <div class="forza-number">
          02
        </div>

        <h3>
          Tú eliges cómo conducir
        </h3>

        <p>
          La familia Forza ofrece opciones para diferentes estilos
          de conducción: <strong>5 velocidades manuales</strong> o
          <strong>transmisión automática</strong>.
        </p>

      </div>


      <!-- ==================================================
           03 · EFICIENCIA
      =================================================== -->

      <div class="forza-card">

        <div class="forza-icon">

          <svg viewBox="0 0 64 64" aria-hidden="true">

            <path
              d="M22 12h20v40H22z"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

            <path
              d="M27 18h10M27 24h10"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

            <path
              d="M32 34c-5 7-7 10-7 14a7 7 0 0 0 14 0c0-4-2-7-7-14z"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

          </svg>

        </div>

        <div class="forza-number">
          03
        </div>

        <h3>
          Eficiencia para tu día
        </h3>

        <p>
          Rendimiento de combustible de hasta
          <strong>45 km/L</strong> en la FZ150A y hasta
          <strong>35 km/L</strong> en la FZ150.
        </p>

      </div>


      <!-- ==================================================
           04 · FUNCIONALIDAD
      =================================================== -->

      <div class="forza-card">

        <div class="forza-icon">

          <svg viewBox="0 0 64 64" aria-hidden="true">

            <rect
              x="12"
              y="20"
              width="40"
              height="30"
              rx="3"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

            <path
              d="M20 20v-6h24v6"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

            <path
              d="M25 32h14M32 25v14"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

          </svg>

        </div>

        <div class="forza-number">
          04
        </div>

        <h3>
          Pensadas para el día a día
        </h3>

        <p>
          Encuentra características funcionales como
          <strong>parrilla o baúl de carga</strong>, según el modelo,
          para llevar lo que necesitas.
        </p>

      </div>


      <!-- ==================================================
           05 · CONECTIVIDAD
      =================================================== -->

      <div class="forza-card">

        <div class="forza-icon">

          <svg viewBox="0 0 64 64" aria-hidden="true">

            <rect
              x="19"
              y="10"
              width="26"
              height="44"
              rx="4"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

            <path
              d="M27 48h10"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

            <path
              d="M32 18v10M27 23h10"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

          </svg>

        </div>

        <div class="forza-number">
          05
        </div>

        <h3>
          Conectividad y practicidad
        </h3>

        <p>
          La FZ150 incorpora
          <strong>porta celular y puerto USB</strong> para acompañarte
          durante tus recorridos.
        </p>

      </div>


      <!-- ==================================================
           06 · FRENADO
      =================================================== -->

      <div class="forza-card">

        <div class="forza-icon">

          <svg viewBox="0 0 64 64" aria-hidden="true">

            <path
              d="M32 10l20 7v15c0 12-8 19-20 23C20 51 12 44 12 32V17z"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

            <path
              d="M22 32l7 7 14-15"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />

          </svg>

        </div>

        <div class="forza-number">
          06
        </div>

        <h3>
          Frenado confiable
        </h3>

        <p>
          Ambas opciones incorporan
          <strong>freno de disco delantero y tambor trasero</strong>.
        </p>

      </div>

    </div>


    <!-- ======================================================
         CTA / COLECCIÓN
    ======================================================= -->

    {% if section.settings.forza_collection != blank %}

      <div class="forza-bottom">

        <div class="forza-bottom-text">

          <span>
            {{ section.settings.bottom_kicker }}
          </span>

          <strong>
            {{ section.settings.bottom_heading }}
          </strong>

        </div>


        <a
          href="{{ section.settings.forza_collection.url }}"
          class="forza-button"
        >

          {{ section.settings.button_text }}

          <span>
            →
          </span>

        </a>

      </div>

    {% endif %}

  </div>

</section>


<!-- ==========================================================
     ESTILOS
=========================================================== -->

<style>

  /* ==========================================================
     CONTENEDOR PRINCIPAL
  =========================================================== */

  .forza-diferenciales {
    background: #000000;
    color: #ffffff;
    padding: 70px 20px;
    position: relative;
    overflow: hidden;
  }


  /* Línea roja decorativa */

  .forza-diferenciales::before {

    content: "";

    position: absolute;

    top: 0;

    right: 8%;

    width: 2px;

    height: 180px;

    background: #E60000;

    transform: skewX(-18deg);

    opacity: .9;

  }


  .forza-container {

    max-width: 1200px;

    margin: 0 auto;

  }


  /* ==========================================================
     HEADER
  =========================================================== */

  .forza-header {

    text-align: center;

    max-width: 720px;

    margin: 0 auto 45px;

  }


  .forza-kicker {

    color: #E60000;

    font-size: 13px;

    font-weight: 800;

    letter-spacing: 2px;

    margin-bottom: 10px;

  }


  .forza-header h2 {

    color: #ffffff;

    font-size: clamp(30px, 4vw, 48px);

    line-height: 1.05;

    margin: 0 0 15px;

    font-weight: 900;

    text-transform: uppercase;

    letter-spacing: -1px;

  }


  .forza-header p {

    color: #bbbbbb;

    font-size: 17px;

    margin: 0;

  }


  /* ==========================================================
     GRID
  =========================================================== */

  .forza-grid {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 2px;

    background: #292929;

  }


  /* ==========================================================
     CARDS
  =========================================================== */

  .forza-card {

    background: #080808;

    padding: 32px 28px;

    min-height: 245px;

    position: relative;

    transition:
      background .25s ease,
      transform .25s ease;

  }


  .forza-card:hover {

    background: #111111;

    transform: translateY(-3px);

  }


  /* ==========================================================
     ICONOS
  =========================================================== */

  .forza-icon {

    color: #E60000;

    width: 45px;

    height: 45px;

    margin-bottom: 18px;

  }


  .forza-icon svg {

    width: 100%;

    height: 100%;

  }


  /* ==========================================================
     NUMERACIÓN
  =========================================================== */

  .forza-number {

    position: absolute;

    top: 22px;

    right: 25px;

    font-size: 12px;

    color: #555555;

    font-weight: 800;

    letter-spacing: 1px;

  }


  /* ==========================================================
     TITULOS
  =========================================================== */

  .forza-card h3 {

    color: #ffffff;

    margin: 0 0 9px;

    font-size: 20px;

    line-height: 1.2;

    font-weight: 800;

    text-transform: uppercase;

  }


  /* ==========================================================
     TEXTO
  =========================================================== */

  .forza-card p {

    color: #999999;

    font-size: 14px;

    line-height: 1.6;

    margin: 0;

  }


  .forza-card strong {

    color: #ffffff;

  }


  /* ==========================================================
     CTA
  =========================================================== */

  .forza-bottom {

    margin-top: 2px;

    background: #E60000;

    padding: 25px 30px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 25px;

  }


  .forza-bottom-text span {

    display: block;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 2px;

    margin-bottom: 4px;

    color: #ffffff;

  }


  .forza-bottom-text strong {

    display: block;

    font-size: 24px;

    line-height: 1.2;

    text-transform: uppercase;

    color: #ffffff;

  }


  /* ==========================================================
     BOTÓN
  =========================================================== */

  .forza-button {

    background: #000000;

    color: #ffffff !important;

    padding: 14px 22px;

    text-decoration: none !important;

    font-size: 13px;

    font-weight: 800;

    letter-spacing: 1px;

    white-space: nowrap;

    transition:
      background .2s ease,
      color .2s ease;

  }


  .forza-button span {

    margin-left: 8px;

    font-size: 18px;

  }


  .forza-button:hover {

    background: #ffffff;

    color: #000000 !important;

  }


  /* ==========================================================
     TABLET
  =========================================================== */

  @media screen and (max-width: 900px) {

    .forza-grid {

      grid-template-columns: repeat(2, 1fr);

    }

  }


  /* ==========================================================
     MOBILE
  =========================================================== */

  @media screen and (max-width: 600px) {

    .forza-diferenciales {

      padding: 50px 15px;

    }


    .forza-header {

      margin-bottom: 30px;

    }


    .forza-header h2 {

      font-size: 30px;

    }


    .forza-header p {

      font-size: 15px;

    }


    .forza-grid {

      grid-template-columns: 1fr;

      gap: 1px;

    }


    .forza-card {

      min-height: auto;

      padding: 25px 22px;

    }


    .forza-bottom {

      flex-direction: column;

      align-items: flex-start;

      padding: 24px;

    }


    .forza-bottom-text strong {

      font-size: 20px;

    }


    .forza-button {

      width: 100%;

      text-align: center;

      box-sizing: border-box;

    }

  }

</style>


<!-- ==========================================================
     SHOPIFY SCHEMA
=========================================================== -->

{% schema %}

{

  "name": "Forza - Diferenciales",

  "tag": "section",

  "class": "section-forza-diferenciales",


  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "¿Qué diferencia nuestras motos?"
    },

    {
      "type": "textarea",
      "id": "subheading",
      "label": "Descripción",
      "default": "Diseño, rendimiento y funcionalidad para acompañarte todos los días."
    },

    {
      "type": "collection",
      "id": "forza_collection",
      "label": "Colección de motos",
      "info": "Selecciona la colección que abrirá el botón."
    },

    {
      "type": "text",
      "id": "bottom_kicker",
      "label": "Texto pequeño del CTA",
      "default": "DOS ESTILOS · UNA FAMILIA"
    },

    {
      "type": "text",
      "id": "bottom_heading",
      "label": "Título del CTA",
      "default": "Elige la Forza que va contigo."
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "VER MOTOS"
    }

  ],


  "presets": [

    {
      "name": "Forza - Diferenciales"
    }

  ]

}

{% endschema %}