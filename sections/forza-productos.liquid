{% comment %}
  ============================================================
  FORZA · CONOCE NUESTROS PRODUCTOS
  Pagina 3 del diseno 2026, copiada tal cual.

  Del PDF:
    - el fondo es un degradado horizontal, de #F8F8F8 a la
      izquierda a #0B0B0B a la derecha
    - el logo va arriba a la izquierda (sobre el fondo claro) y el
      titulo arriba a la derecha, alineado a la derecha
    - la moto entra por el borde izquierdo
    - las tarjetas son rectangulos de esquina viva, con el texto
      al centro vertical y pegado a la izquierda
  ============================================================
{% endcomment %}

{% liquid
  assign uid = section.id | replace: '_', '' | downcase
  assign velo = section.settings.card_overlay | times: 0.01
%}

<section class="fpr fpr-{{ uid }}">

  {% if section.settings.side_image != blank %}
    {% comment %} el marco recorta la moto justo donde empieza la tarjeta grande {% endcomment %}
    <div class="fpr-{{ uid }}__marco" aria-hidden="true">
      <img
        class="fpr-{{ uid }}__moto"
        src="{{ section.settings.side_image | image_url: width: 1400 }}"
        alt=""
        width="{{ section.settings.side_image.width }}"
        height="{{ section.settings.side_image.height }}"
        loading="lazy"
      >
    </div>
  {% endif %}

  <div class="fpr-{{ uid }}__contenido">

    <div class="fpr-{{ uid }}__encabezado">

      {% if section.settings.logo != blank %}
        <img
          class="fpr-{{ uid }}__logo{% if section.settings.logo_white %} fpr-{{ uid }}__logo--blanco{% endif %}"
          src="{{ section.settings.logo | image_url: width: 900 }}"
          alt="{{ shop.name | escape }}"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          loading="lazy"
        >
      {% else %}
        <span></span>
      {% endif %}

      <div class="fpr-{{ uid }}__texto">

        {% if section.settings.kicker != blank %}
          <p class="fpr-{{ uid }}__kicker">
            <span>{{ section.settings.kicker }}</span>
            <i aria-hidden="true"></i>
          </p>
        {% endif %}

        {% if section.settings.title_bottom != blank %}
          <h2 class="fpr-{{ uid }}__titulo">{{ section.settings.title_bottom }}</h2>
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <p class="fpr-{{ uid }}__bajada">{{ section.settings.subtitle }}</p>
        {% endif %}

      </div>

    </div>

    {% if section.blocks.size > 0 %}
      <div class="fpr-{{ uid }}__mosaico">
        {% for block in section.blocks %}
          {%- liquid
            assign clases = 'fpr-' | append: uid | append: '__carta'
            if block.settings.large
              assign clases = clases | append: ' fpr-' | append: uid | append: '__carta--grande'
            endif
          -%}
          <article
            class="{{ clases }}"
            {% if block.settings.image != blank %}
              style="--fpr-foto: url({{ block.settings.image | image_url: width: 1400 }});"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <div class="fpr-{{ uid }}__cuerpo">

              {% if block.settings.title != blank %}
                <h3 class="fpr-{{ uid }}__carta-titulo">{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <p class="fpr-{{ uid }}__carta-texto">{{ block.settings.text }}</p>
              {% endif %}

              {% if block.settings.button_label != blank and block.settings.link != blank %}
                <a
                  class="fpr-{{ uid }}__carta-boton"
                  href="{{ block.settings.link | escape }}"
                  {% if block.settings.new_tab %}
                    target="_blank"
                    rel="noopener"
                  {% endif %}
                >
                  {{ block.settings.button_label }}
                  {% if block.settings.new_tab %}
                    <span class="fpr__oculto">(se abre en una ventana nueva)</span>
                  {% endif %}
                </a>
              {% endif %}

            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

  </div>

</section>

{% style %}
  .fpr-{{ uid }} {
    /* el ancho del PDF, para que en pantallas grandes no quede una isla */
    --fpr-tope: 1920px;
    --fpr-lado: 20px;
    /* la franja libre de la izquierda, donde se asoma la moto */
    --fpr-canal: clamp(0px, 11vw, 160px);
    /* margen que sobra cuando la pantalla es mas ancha que el tope */
    --fpr-desborde: max(
      0px,
      calc((100vw - 2 * var(--fpr-lado) - var(--fpr-tope)) / 2)
    );
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* degradado horizontal, medido del PDF */
    background: linear-gradient(
      to right,
      {{ section.settings.gradient_from }} 0%,
      #c2c2c2 30%,
      #959595 50%,
      #606060 70%,
      {{ section.settings.gradient_to }} 100%
    );
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }

  /* La moto entra por el borde izquierdo. El marco va desde la orilla
     de la seccion hasta donde arranca la tarjeta grande, asi que se
     asoma lo mismo sea cual sea el ancho de la pantalla. */
  .fpr-{{ uid }}__marco {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 0;
    width: calc(var(--fpr-lado) + var(--fpr-desborde) + var(--fpr-canal));
    height: {{ section.settings.side_height }}%;
    overflow: hidden;
    pointer-events: none;
  }

  .fpr-{{ uid }}__moto {
    position: absolute;
    left: 0;
    bottom: 0;
    width: auto;
    height: 100%;
    max-width: none;
    transform: translateX(-{{ section.settings.side_shift }}%);
    filter: drop-shadow(0 18px 34px rgba(0, 0, 0, .4));
  }

  .fpr-{{ uid }}__contenido {
    position: relative;
    z-index: 1;
    max-width: var(--fpr-tope);
    margin: 0 auto;
  }

  .fpr-{{ uid }}__encabezado {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 24px;
    margin-bottom: clamp(24px, 3.4vw, 46px);
  }

  .fpr-{{ uid }}__logo {
    display: block;
    width: clamp(190px, 27vw, 420px);
    height: auto;
  }

  .fpr-{{ uid }}__logo--blanco {
    filter: brightness(0) invert(1);
  }

  .fpr-{{ uid }}__texto {
    text-align: right;
  }

  .fpr-{{ uid }}__kicker {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
    margin: 0 0 2px;
    color: #a9a9a9;
    font-size: clamp(13px, 1.65vw, 24px);
    font-weight: 400;
    letter-spacing: .34em;
    text-transform: uppercase;
  }

  .fpr-{{ uid }}__kicker i {
    display: block;
    flex: 0 0 auto;
    width: clamp(44px, 5.5vw, 86px);
    height: 4px;
    background: {{ section.settings.accent_color }};
  }

  .fpr-{{ uid }}__titulo {
    margin: 0 0 6px;
    color: {{ section.settings.accent_color }};
    font-family: var(--font-heading--family, sans-serif);
    font-size: clamp(40px, 6.6vw, 96px);
    font-style: italic;
    font-weight: 900;
    line-height: .92;
    text-transform: uppercase;
    text-shadow: .05em .05em 0 rgba(0, 0, 0, .55);
  }

  .fpr-{{ uid }}__bajada {
    margin: 0;
    color: #f0f0f0;
    font-size: clamp(14px, 1.65vw, 25px);
    font-weight: 300;
  }

  /* ---- mosaico ---- */

  .fpr-{{ uid }}__mosaico {
    display: grid;
    grid-template-columns: 1.23fr 1fr;
    grid-auto-rows: auto;
    gap: clamp(14px, 2vw, 28px);
    /* deja libre la franja de la izquierda donde va la moto */
    padding-inline-start: var(--fpr-canal);
  }

  .fpr-{{ uid }}__carta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(190px, 22vw, 320px);
    padding: clamp(18px, 2vw, 30px);
    /* esquina viva, como en el diseno */
    border-radius: 0;
    background-color: #111111;
    background-image: var(--fpr-foto, none);
    background-size: cover;
    background-position: center;
    box-shadow: 0 18px 38px rgba(0, 0, 0, .45);
    transition: transform .25s ease;
  }

  /* la tarjeta grande manda el alto; en el PDF es practicamente
     cuadrada, y asi se mantiene en cualquier ancho de pantalla */
  .fpr-{{ uid }}__carta--grande {
    grid-row: span 2;
    aspect-ratio: 1 / 1.03;
  }

  .fpr-{{ uid }}__carta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(0, 0, 0, {{ velo }});
  }

  .fpr-{{ uid }}__carta:hover {
    transform: translateY(-4px);
  }

  .fpr-{{ uid }}__cuerpo {
    position: relative;
  }

  .fpr-{{ uid }}__carta-titulo {
    margin: 0 0 4px;
    color: #ffffff;
    font-family: var(--font-heading--family, sans-serif);
    font-size: clamp(22px, 2.9vw, 43px);
    line-height: 1.1;
    text-transform: uppercase;
    text-shadow: 0 2px 14px rgba(0, 0, 0, .6);
  }

  .fpr-{{ uid }}__carta-texto {
    margin: 0 0 clamp(14px, 1.8vw, 24px);
    color: #f2f2f2;
    font-size: clamp(14px, 1.75vw, 28px);
    font-weight: 300;
    text-shadow: 0 2px 12px rgba(0, 0, 0, .6);
  }

  .fpr-{{ uid }}__carta-boton {
    display: inline-block;
    padding: clamp(10px, 1.2vw, 16px) clamp(24px, 2.8vw, 42px);
    border-radius: 999px;
    background: {{ section.settings.accent_color }};
    color: #ffffff !important;
    text-decoration: none !important;
    font-size: clamp(12px, 1.3vw, 20px);
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    transition: filter .2s ease;
  }

  .fpr-{{ uid }}__carta-boton:hover {
    filter: brightness(1.18);
  }

  .fpr-{{ uid }}__carta-boton:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  .fpr__oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (max-width: 900px) {
    /* En celular se apila: arriba la franja clara con la moto, el
       logo y el titulo; abajo el fondo oscuro con las fotos. */
    .fpr-{{ uid }} {
      display: flex;
      flex-direction: column;
      padding-top: 0;
      padding-inline: 16px;
      background: {{ section.settings.gradient_to }};
    }

    .fpr-{{ uid }}__marco {
      order: 1;
      position: static;
      width: calc(100% + 32px);
      height: auto;
      margin: 0 -16px;
      overflow: visible;
      background: linear-gradient(
        to bottom,
        {{ section.settings.gradient_from }} 0%,
        #ededed 100%
      );
    }

    .fpr-{{ uid }}__moto {
      position: static;
      width: 100%;
      height: auto;
      transform: none;
    }

    .fpr-{{ uid }}__encabezado {
      margin: 0 -16px clamp(18px, 4vw, 28px);
      padding: 6px 16px 22px;
      background: #ededed;
    }

    /* sobre esa franja clara el texto va oscuro */
    .fpr-{{ uid }}__kicker {
      color: #6a6a6a;
    }

    .fpr-{{ uid }}__titulo {
      text-shadow: none;
    }

    .fpr-{{ uid }}__bajada {
      color: #2b2b2b;
    }

    .fpr-{{ uid }}__contenido {
      order: 2;
    }

    .fpr-{{ uid }}__encabezado {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .fpr-{{ uid }}__texto {
      text-align: center;
    }

    .fpr-{{ uid }}__kicker {
      justify-content: center;
    }

    .fpr-{{ uid }}__mosaico {
      grid-template-columns: 1fr;
      padding-inline-start: 0;
    }

    .fpr-{{ uid }}__carta--grande {
      grid-row: span 1;
      aspect-ratio: auto;
      min-height: 260px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Forza · Productos",
  "tag": "section",
  "class": "section-forza-productos",
  "max_blocks": 6,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Va arriba a la izquierda, donde el fondo es claro, así que sirve el logo negro."
    },
    {
      "type": "checkbox",
      "id": "logo_white",
      "label": "Pintar el logo de blanco",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Foto de la moto",
      "info": "Sale por el borde izquierdo. Funciona mejor un PNG sin fondo."
    },
    {
      "type": "range",
      "id": "side_height",
      "label": "Alto de la moto",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 70
    },
    {
      "type": "range",
      "id": "side_shift",
      "label": "Cuánto se sale por la izquierda",
      "info": "Decide qué parte de la moto asoma: más bajo muestra el tanque, más alto la rueda delantera.",
      "min": 0,
      "max": 92,
      "step": 1,
      "unit": "%",
      "default": 47
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Antetítulo",
      "default": "Conoce nuestros"
    },
    {
      "type": "text",
      "id": "title_bottom",
      "label": "Título",
      "default": "Productos"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Bajada",
      "default": "Más que una motocicleta, una compañera en tu camino."
    },
    { "type": "header", "content": "Apariencia" },
    {
      "type": "color",
      "id": "gradient_from",
      "label": "Fondo, lado izquierdo",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "gradient_to",
      "label": "Fondo, lado derecho",
      "default": "#0b0b0b"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Rojo Forza",
      "default": "#AF190F"
    },
    {
      "type": "range",
      "id": "card_overlay",
      "label": "Oscurecer las fotos de las tarjetas",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio arriba",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio abajo",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "carta",
      "name": "Tarjeta",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto de fondo" },
        { "type": "text", "id": "title", "label": "Título", "default": "Motos Forza" },
        { "type": "text", "id": "text", "label": "Texto" },
        {
          "type": "checkbox",
          "id": "large",
          "label": "Tarjeta grande",
          "info": "Ocupa el doble de alto, como la de motos en el diseño.",
          "default": false
        },
        { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Conoce más" },
        { "type": "url", "id": "link", "label": "Enlace del botón" },
        { "type": "checkbox", "id": "new_tab", "label": "Abrir en una ventana nueva", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Forza · Productos",
      "blocks": [
        { "type": "carta", "settings": { "title": "Motos Forza", "text": "Tu trabajo, tu camino, tu libertad.", "large": true, "button_label": "Conoce más" } },
        { "type": "carta", "settings": { "title": "Accesorios Forza", "text": "Dale personalidad a tu moto.", "large": false, "button_label": "Conoce más" } },
        { "type": "carta", "settings": { "title": "Bicicletas Forza", "text": "Tu trabajo, tu camino, tu libertad.", "large": false, "button_label": "Conoce más" } }
      ]
    }
  ]
}
{% endschema %}